<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- Screen title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Your Order"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#C8102E"
        android:gravity="center"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="24dp" />

    <!-- Customer name -->
    <EditText
        android:id="@+id/nameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your name"
        android:inputType="textPersonName"
        android:autofillHints="name"
        android:textColor="#333333"
        android:textColorHint="#777777"
        android:layout_marginBottom="12dp" />

    <!-- Recent orders for this customer -->
    <TextView
        android:id="@+id/recentOrdersTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recent Orders: None"
        android:textSize="15sp"
        android:textColor="#555555"
        android:layout_marginBottom="24dp" />

    <!-- Drink label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose your drink:"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#C8102E" />

    <!-- Drink selection -->
    <Spinner
        android:id="@+id/drinkSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp" />

    <!-- Size label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose your size:"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#C8102E" />

    <!-- Size selection -->
    <Spinner
        android:id="@+id/sizeSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp" />

    <!-- Save the order -->
    <Button
        android:id="@+id/saveOrderButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Order"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#C8102E" />

</LinearLayout>